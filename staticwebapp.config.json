{
  "navigationFallback": {
    "rewrite": "/index.html"
  },
  "routes": [
    {
      "route": "/.well-known/apple-app-site-association",
      "rewrite": "/well-known/apple-app-site-association"
    },
    {
      "route": "/.well-known/assetlinks.json",
      "rewrite": "/well-known/assetlinks.json"
    },
    {
      "route": "/index.html",
      "headers": {
        "Cache-Control": "no-store"
      }
    }
  ],
  "mimeTypes": {
    ".json": "application/json"
  }
}
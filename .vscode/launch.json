      "toolArgs": [
        "--dart-define",
        "EMAIL_LOGIN_CALLBACK_URL=http://localhost:4200",
        "--dart-define",
        "APP_TITLE=EMR Self-Serve Portal (Beta)"
      ]
    },
    {
      "name": "Portal web (prod)",
      "cwd": "packages/portal_shell_web",
      "request": "launch",
      "type": "dart",
      "program": "lib/main.dart",
      "args": ["-d", "chrome", "--web-port", "3000"],
      "toolArgs": [
        "--dart-define",
        "EMAIL_LOGIN_CALLBACK_URL=http://localhost:3000",
        "--dart-define",
        "APP_TITLE=EMR Self-Serve Portal"
      ]
    }
  ]
